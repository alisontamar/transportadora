#VRML_SIM R2025a utf8

# Simulación 3D en Webots del sistema completo (etapa SIN PID/PI): banda +
# motor + encoder, sensor de presencia, cámara, desviador, 3 compartimentos
# (A/B/C) y sensor de verificación con señal verde/roja. La animación la
# maneja controllers/loop_products/loop_products.py.
#
# Nota: este mundo usa solo nodos nativos de Webots (Solid/Shape/Box/Plane/
# Background/luces), sin EXTERNPROTO de la librería estándar (ConveyorBelt,
# PlasticCrate, RectangleArena, TexturedBackground...). Esos PROTO se
# descargan de internet la primera vez que se usan, y en este equipo esa
# descarga estaba fallando (ver preferencias de red de Webots), dejando la
# escena vacía. Con nodos nativos el mundo abre igual con o sin internet.

WorldInfo {
  info [
    "Sistema de Clasificación de Productos - vistazo inicial en Webots."
    "Banda + motor/encoder + sensor + cámara + desviador + compartimentos A/B/C + señal verde/roja."
  ]
  title "Transportadora - vistazo 3D"
  basicTimeStep 16
}
Viewpoint {
  orientation -0.2837 0.2837 0.9160 1.6584
  position 0.25 -2.7 2.0
}
Background {
  skyColor [
    0.6 0.65 0.7
  ]
}
DirectionalLight {
  direction 0.4 0.4 -1
  intensity 1.5
  castShadows TRUE
}
PointLight {
  location 0 0 1.5
  intensity 2
}

Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 4.6 2.2
      }
    }
  ]
  name "piso"
}

Solid {
  translation 0 0 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.25 0.25
        roughness 0.8
        metalness 0.1
      }
      geometry Box {
        size 2.4 0.5 0.3
      }
    }
  ]
  name "banda transportadora"
}

